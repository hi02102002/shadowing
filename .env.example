# SQLite (tự tạo thư mục + migrate khi khởi động)
DATABASE_URL="data/app.db"

# ---- LLM phân tích lỗi (có thể đổi ở trang /settings) ----
# openai | anthropic | gemini | ollama | openai-compatible
LLM_PROVIDER=openai
LLM_MODEL=gpt-5-mini
LLM_API_KEY=
# Bắt buộc với openai-compatible (vd. https://openrouter.ai/api/v1), tuỳ chọn với các provider khác
LLM_BASE_URL=

# ---- Chấm phát âm: llm-audio (model LLM ở trên nghe trực tiếp, mặc định) | stt (Whisper) ----
PRONUNCIATION_ENGINE=llm-audio

# ---- Speech-to-Text (chỉ dùng khi PRONUNCIATION_ENGINE=stt): endpoint /audio/transcriptions chuẩn OpenAI ----
# OpenAI: để trống STT_BASE_URL, STT_MODEL=whisper-1
# Groq:   STT_BASE_URL=https://api.groq.com/openai/v1  STT_MODEL=whisper-large-v3-turbo
STT_BASE_URL=
STT_API_KEY=
STT_MODEL=whisper-1

# Đường dẫn yt-dlp (mặc định: ./bin/yt-dlp nếu có, ngược lại yt-dlp trong PATH)
# YTDLP_PATH=
